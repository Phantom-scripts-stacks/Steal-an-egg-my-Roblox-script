    fpsBoostBtn.Text = "FPS Boost: " .. (state.fpsBoost and "ON" or "OFF")
    setBtn(fpsBoostBtn, state.fpsBoost)
    if state.fpsBoost then
        for _, fx in ipairs(Lighting:GetChildren()) do
            if fx:IsA("PostEffect") then
                fpsBoostCache[fx] = fx.Enabled
                fx.Enabled = false
            end
        end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                fpsBoostCache[obj] = obj.Enabled
                obj.Enabled = false
            end
        end
    else
        for obj, wasEnabled in pairs(fpsBoostCache) do
            pcall(function()
                if obj and obj.Parent then
                    obj.Enabled = wasEnabled
                end
            end)
        end
        fpsBoostCache = {}
    end
end)

