local function isEggTaken(egg)
    local node = egg
    for _ = 1, 6 do
        if not node or node == workspace then break end
        if node.Parent and node.Parent.Name == "Plots" then return true end
        if Players:GetPlayerFromCharacter(node) then return true end
        local o = node:GetAttribute("Owner")
        if o and tostring(o) ~= "" then return true end
        node = node.Parent
    end
    if Players:GetPlayerFromCharacter(egg.Parent) then return true end
    if egg.Parent and egg.Parent.Name == "Backpack" then return true end
    return false
end

local function getEggPart(e)
    if e:IsA("BasePart") then return e end
    return e.PrimaryPart or e:FindFirstChild("HumanoidRootPart") or e:FindFirstChildWhichIsA("BasePart")
end

local function findBestEgg()
    local best, bs = nil, -1
    for _, egg in ipairs(workspace:GetDescendants()) do
        local ok = (egg:IsA("Model") or egg:IsA("BasePart")) and egg.Name:lower():match(CONFIG.EggMatch)
        if ok and not isEggTaken(egg) then
            local s = EGG_PRIORITY[egg.Name] or 0
            if s > bs then best, bs = egg, s end
        end
    end
    return best
end

tpBestBtn.MouseButton1Click:Connect(function()
    local best = findBestEgg()
    if not best then
        tpBestBtn.Text = "No egg found"
        task.wait(1)
        tpBestBtn.Text = "Teleport to Best Egg"
        return
    end
    local part = getEggPart(best)
    if not part then return end
    local target = part.Position + Vector3.new(0, 4, 0)
    pcall(function() character:PivotTo(CFrame.new(target)) end)
    tpBestBtn.Text = "Teleported!"
    task.wait(1)
    tpBestBtn.Text = "Teleport to Best Egg"
end)

tpBaseBtn.MouseButton1Click:Connect(function()
    pcall(function() character:PivotTo(CONFIG.BaseCFrame) end)
end)

eggToBaseBtn.MouseButton1Click:Connect(function()
    local eggs = {}
    for _, egg in ipairs(workspace:GetDescendants()) do
        local ok = (egg:IsA("Model") or egg:IsA("BasePart")) and egg.Name:lower():match(CONFIG.EggMatch)
        if ok and not isEggTaken(egg) then
            local part = getEggPart(egg)
            if part then table.insert(eggs, { obj = egg, part = part }) end
        end
    end
    if #eggs == 0 then return end
    local nearest, nd = nil, math.huge
    for _, e in ipairs(eggs) do
        local d = (e.part.Position - rootPart.Position).Magnitude
        if d < nd then nearest, nd = e, d end
    end
    if nearest then
        pcall(function()
            if nearest.obj:IsA("BasePart") then
                nearest.obj.CFrame = CONFIG.BaseCFrame
            else
                nearest.obj:PivotTo(CONFIG.BaseCFrame)
            end
        end)
    end
end)

