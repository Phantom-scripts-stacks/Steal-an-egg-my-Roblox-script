local function updateSlider(x)
    local ap = sliderBar.AbsolutePosition
    local as_ = sliderBar.AbsoluteSize
    local rel = math.clamp((x - ap.X) / as_.X, 0, 1)
    local v = math.floor(1 + 999 * rel)
    state.speedValue = v
    sliderLabel.Text = "Speed: " .. v
    sliderFill.Size = UDim2.new(rel, 0, 1, 0)
    sliderKnob.Position = UDim2.new(rel, -9, 0.5, -9)
