tpBaseBtn.MouseButton1Click:Connect(function()
    if teleporting then
        teleporting = false
        tpBaseBtn.Text = baseName
        return
    end

    teleporting = true
    tpBaseBtn.Text = "Teleporting..."

    local STEP_SIZE = 100
    local STEP_DELAY = 0.05
    local BASE_POSITION = CONFIG.BaseCFrame.Position

    task.spawn(function()
        local c = player.Character or player.CharacterAdded:Wait()
        local r = c:WaitForChild("HumanoidRootPart")
        local distance = (BASE_POSITION - r.Position).Magnitude
        local steps = math.ceil(distance / STEP_SIZE)

        for i = 1, steps do
            if not teleporting then break end
            if hasEgg() then
                teleporting = false
                tpBaseBtn.Text = baseName
                break
            end
            local cc = player.Character
            if not cc then break end
            local rr = cc:FindFirstChild("HumanoidRootPart")
            if not rr then break end

            local currentPos = rr.Position
            local diff = BASE_POSITION - currentPos
            local distLeft = diff.Magnitude

            if distLeft < STEP_SIZE then
                pcall(function() cc:PivotTo(CFrame.new(BASE_POSITION)) end)
                break
            end

            local direction = diff.Unit
            local newPos = currentPos + direction * STEP_SIZE

            pcall(function() cc:PivotTo(CFrame.new(newPos)) end)

            task.wait(STEP_DELAY)
        end

        teleporting = false
        tpBaseBtn.Text = baseName
    end)
end)

