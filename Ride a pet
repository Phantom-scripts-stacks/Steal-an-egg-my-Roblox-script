    while task.wait(0.3) do
        if state.speedOn then applySpeed() end
    end
end)

task.spawn(function()
    while task.wait(0.3) do
        if state.jumpOn then applyJump() end
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if state.autoSprint then
            pcall(function()
                local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                if h and h.MoveDirection.Magnitude > 0 then
                    h.WalkSpeed = math.max(h.WalkSpeed, 25)
                end
            end)
        end
    end
end)

player.CharacterAdded:Connect(function(c)
    character = c
    humanoid  = c:WaitForChild("Humanoid")
    rootPart  = c:WaitForChild("HumanoidRootPart")
    task.wait(0.5)
    applySpeed()
    if state.jumpOn then applyJump() end
end)

-- ============ LAUNCH ============
pcall(playIntro)
task.wait(4.2)
if intro and intro.Parent then
    intro.Visible = false
    intro:Destroy()
end
win.Visible = true
winOpen = true
iconStroke.Color = T.bad
