    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    btn.Parent = tabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke")
    s.Color = T.panelHi
    s.Parent = btn

    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, -20, 1, -96)
    page.Position = UDim2.new(0, 10, 0, 88)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = win

    pages[name] = { btn = btn, page = page, stroke = s }
    btn.MouseButton1Click:Connect(function()
        for n, p in pairs(pages) do
            p.page.Visible = (n == name)
            if n == name then
                p.btn.BackgroundColor3 = T.accent
                p.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                p.stroke.Color = T.accent2
                p.stroke.Thickness = 2
            else
                p.btn.BackgroundColor3 = T.panel
                p.btn.TextColor3 = T.dim
                p.stroke.Color = T.panelHi
                p.stroke.Thickness = 1
            end
        end
    end)
    return page
end

