    local ap = speedBar.AbsolutePosition
    local as_ = speedBar.AbsoluteSize
    local rel = math.clamp((x - ap.X) / as_.X, 0, 1)
    local v = math.floor(1 + 999 * rel)
    state.speedValue = v
    speedLabel.Text = "Speed: " .. v
    speedFill.Size = UDim2.new(rel, 0, 1, 0)
    speedKnob.Position = UDim2.new(rel, -8, 0.5, -8)
    if state.speedOn then applySpeed() end
end

