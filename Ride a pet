    box.Adornee = part
    box.AlwaysOnTop = true
    box.Size = part.Size + Vector3.new(0.5, 0.5, 0.5)
    box.Transparency = 0.35
    box.Color3 = color
    box.Parent = espFolder

    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.Size = UDim2.new(0, 140, 0, 24)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = espFolder

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 1, 0)
    t.BackgroundTransparency = 1
    t.Text = label
    t.TextColor3 = color
    t.TextStrokeTransparency = 0
    t.TextStrokeColor3 = Color3.new(0,0,0)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 11
    t.Parent = bb
end

local function clearESP()
    for _, c in ipairs(espFolder:GetChildren()) do c:Destroy() end
end

local function refreshESP()
    clearESP()
    if not state.espOn then return end
    local c = player.Character
    if not c then return end
    local rp = c:FindFirstChild("HumanoidRootPart")
    if not rp then return end
    for _, egg in ipairs(workspace:GetDescendants()) do
        local ok = (egg:IsA("Model") or egg:IsA("BasePart")) and egg.Name:lower():match(CONFIG.EggMatch)
        if ok and not isEggTaken(egg) then
            local part = getEggPart(egg)
            if part then
                local d = (part.Position - rp.Position).Magnitude
                if d <= CONFIG.ESPRange then
                    createESP(part, string.format("%s [%dm]", egg.Name, math.floor(d)), eggColor(egg.Name))
                end
            end
        end
    end
end

