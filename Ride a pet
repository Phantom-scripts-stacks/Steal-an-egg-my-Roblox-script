local function playIntro()
    intro.Visible = true
    intro.BackgroundTransparency = 0
    square.Size = UDim2.new(0, 100, 0, 100)
    square.BackgroundTransparency = 1
    squareStroke.Transparency = 1
    introImage.ImageTransparency = 1
    introTitle.Position = UDim2.new(0.5, 0, 0.5, 180)
    introTitle.TextTransparency = 1

    task.spawn(function()
        local startT = tick()
        local dur = 1.0
        while true do
            local p = math.clamp((tick() - startT) / dur, 0, 1)
            local eased = 1 - (1 - p) ^ 3
            local size = 100 + (260 - 100) * eased
            square.Size = UDim2.new(0, size, 0, size)
            square.BackgroundTransparency = 1 - eased
            squareStroke.Transparency = 1 - eased
            introImage.ImageTransparency = 1 - eased
            if p >= 1 then break end
            task.wait(0.03)
        end

        local startT2 = tick()
        local dur2 = 0.8
        while true do
            local p = math.clamp((tick() - startT2) / dur2, 0, 1)
            local eased = 1 - (1 - p) ^ 3
            introTitle.Position = UDim2.new(0.5, 0, 0.5, 180 - (180 - 140) * eased)
            introTitle.TextTransparency = 1 - eased
            if p >= 1 then break end
            task.wait(0.03)
        end

        task.wait(2.0)

        local startT3 = tick()
        local dur3 = 0.8
        while true do
            local p = math.clamp((tick() - startT3) / dur3, 0, 1)
            square.BackgroundTransparency = p
            squareStroke.Transparency = p
            introImage.ImageTransparency = p
            introTitle.TextTransparency = p
            intro.BackgroundTransparency = p
            if p >= 1 then break end
            task.wait(0.03)
        end
        intro.Visible = false
    end)
end

