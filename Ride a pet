local FIND_SKIP_ROOTS = {
    "Ground", "Decorations", "Props", "Terrain",
    "Camera", "Lighting", "Effects", "VFX",
}
local FIND_REQUIRE_KW = { "egg", "spawn", "shop", "nest" }

local function findIsUnderSkipRoot(obj)
    local node = obj
    while node and node ~= workspace do
        for _, skip in ipairs(FIND_SKIP_ROOTS) do
            if node.Name == skip then return true end
        end
        node = node.Parent
    end
    return false
end

local function findHasRequiredKeyword(name)
    local n = name:lower()
    for _, k in ipairs(FIND_REQUIRE_KW) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function findCollectEggs()
    local list = {}
    local seen = {}
    local re = workspace:FindFirstChild("RenderedEggs")
    if re then
        for _, egg in ipairs(re:GetChildren()) do
            if egg:IsA("Model") or egg:IsA("BasePart") then
                local part = egg:IsA("BasePart") and egg
                    or egg.PrimaryPart
                    or egg:FindFirstChildWhichIsA("BasePart")
                if part then
                    table.insert(list, {
                        obj = egg, part = part, name = egg.Name,
                        taken = isEggTaken(egg),
                    })
                    seen[egg] = true
                end
            end
        end
    end
    for _, o in ipairs(workspace:GetDescendants()) do
        if o.Name:lower():match(CONFIG.EggMatch) and not seen[o] then
            if not findIsUnderSkipRoot(o) and findHasRequiredKeyword(o.Name) then
                local part
                if o:IsA("BasePart") then part = o
                elseif o:IsA("Model") then
                    part = o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
                end
                if part then
                    table.insert(list, {
                        obj = o, part = part, name = o.Name,
                        taken = isEggTaken(o),
                    })
                    seen[o] = true
                end
            end
        end
    end
    return list
end

local function getPetNameInsideEgg(egg)
    local obj = egg.obj
    for _, a in ipairs({"Pet","PetName","Contents","Content","Inside","Reward","Item","Name"}) do
        local v = obj:GetAttribute(a)
        if v and type(v) == "string" and #v > 1 then return v end
    end
    for _, d in ipairs(obj:GetDescendants()) do
        local n = d.Name:lower()
        if d:IsA("StringValue") and (n:find("pet") or n:find("content") or n:find("inside") or n:find("reward") or n:find("name")) then
            if d.Value and #d.Value > 1 then return d.Value end
        elseif d:IsA("ObjectValue") and (n:find("pet") or n:find("content") or n:find("inside")) then
            if d.Value then return d.Value.Name end
        end
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text and #d.Text > 1 then
            local txt = d.Text
            local m = txt:match("[Pp]et[:%s]*([%w%s%-']+)")
            if m and #m > 1 then return m:gsub("^%s+",""):gsub("%s+$","") end
            if not txt:lower():find("egg") and #txt > 2 and #txt < 40 then
                return txt
            end
        end
    end
    for _, d in ipairs(obj:GetChildren()) do
        if d:IsA("Model") and d ~= obj and #d.Name > 2 and not d.Name:lower():find("egg") then
            return d.Name
        end
    end
    return nil
end

local function findTeleportBiggest()
    local list = findCollectEggs()
    local best, bestScore = nil, -1
    for _, e in ipairs(list) do
        if not e.taken then
            local score = 0
            if e.obj:IsA("BasePart") then
                local s = e.obj.Size
                score = s.X + s.Y + s.Z
            else
                for _, p in ipairs(e.obj:GetDescendants()) do
                    if p:IsA("BasePart") then
                        local s = p.Size
                        local sc = s.X + s.Y + s.Z
                        if sc > score then score = sc end
                    end
                end
            end
            if score > bestScore then best, bestScore = e, score end
        end
    end
    if not best then findLog("No available egg found"); return end
    local c = player.Character
    if not c then return end
    pcall(function()
        c:PivotTo(CFrame.new(best.part.Position + Vector3.new(0, 4, 0)))
    end)
    findLog(string.format("Biggest: %s (size %.0f)", best.name, bestScore))
end

local function findTeleportByName(query)
    if not query or query == "" then findLog("Type a name first"); return end
    local q = query:lower()
    local list = findCollectEggs()
    local hits = {}
    for _, e in ipairs(list) do
        if not e.taken then
            local petName = getPetNameInsideEgg(e)
            e.petName = petName
            if e.name:lower():find(q, 1, true) or (petName and petName:lower():find(q, 1, true)) then
                table.insert(hits, e)
            end
        end
    end
    if #hits == 0 then
        findLog("No egg containing '"..query.."'")
        return
    end
    findLog("Found "..#hits.." match(es):")
    for i = 1, math.min(5, #hits) do
        local h = hits[i]
        findLog("  "..h.name.."  ("..(h.petName or "?")..")")
    end
    local c = player.Character
    if not c then return end
    pcall(function()
        c:PivotTo(CFrame.new(hits[1].part.Position + Vector3.new(0, 4, 0)))
    end)
    findLog("TP -> "..hits[1].name.." ["..(hits[1].petName or "?").."]")
end

local function findListEggs()
    for _, c in ipairs(findScroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
    local list = findCollectEggs()
    local avail = 0
    for _, e in ipairs(list) do if not e.taken then avail = avail + 1 end end
    findLog("Eggs: "..#list.." | Available: "..avail)
    for i, e in ipairs(list) do
        local tag = e.taken and "[TAKEN]" or "[FREE] "
        local petName = getPetNameInsideEgg(e)
        findLog(string.format("%2d. %s %s  ->  %s", i, tag, e.name, petName or "?"))
    end
end

