local baseName   = "GO TO PLOT"

local baseFlyState = { flying = false, noclipOn = false }

local baseSavedState = {
    hadNoclip = false,
    hadFly = false,
    walkSpeed = 16,
    jumpPower = 50,
}

local function findMyBaseFly()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            local data = plot:FindFirstChild("Data")
            local owner = data and data:FindFirstChild("Owner")
            if owner and owner:IsA("ObjectValue") then
                local v = owner.Value
                if v and (v.Name == player.Name
                    or tostring(v) == tostring(player.UserId)) then
                    return plot:GetPivot().Position
                end
            end
            local nest = plot:GetAttribute("NestsOwnerLoaded")
            if nest and tostring(nest) == tostring(player.UserId) then
                return plot:GetPivot().Position
            end
        end
    end
    return nil
end

local function baseNoclipApply()
    local c = player.Character
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end

local function baseNoclipRestore()
    local c = player.Character
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = true
        end
    end
end

task.spawn(function()
    while task.wait(0.15) do
        if baseFlyState.noclipOn then pcall(baseNoclipApply) end
    end
end)

local function baseFullStop(reason)
    baseFlyState.flying   = false
    baseFlyState.noclipOn = false

    if not baseSavedState.hadNoclip then
        pcall(baseNoclipRestore)
    end

    local c = player.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then
            h:MoveTo(c:GetPivot().Position)
            h.WalkSpeed = baseSavedState.walkSpeed
            h.JumpPower = baseSavedState.jumpPower
            h.UseJumpPower = true
        end
        for _, obj in ipairs(c:GetDescendants()) do
            if (obj:IsA("BodyVelocity") or obj:IsA("BodyGyro"))
                and obj.Name == "GoToPlotMover" then
                pcall(function() obj:Destroy() end)
            end
        end
    end

    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        cam.CameraSubject = player.Character
            and player.Character:FindFirstChildOfClass("Humanoid")
    end

    tpBaseBtn.Text = baseName
    tpBaseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tpBaseBtn.BackgroundColor3 = Color3.fromRGB(35, 20, 60)
end

tpBaseBtn.MouseButton1Click:Connect(function()
    if baseFlyState.flying then
        baseFullStop("Cancelled")
        return
    end

    local c = player.Character
    if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then return end

    local basePos = findMyBaseFly()
    if not basePos then
        tpBaseBtn.Text = "Base not found"
        task.wait(1)
        tpBaseBtn.Text = baseName
        tpBaseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tpBaseBtn.BackgroundColor3 = Color3.fromRGB(35, 20, 60)
        return
    end

    local h = c:FindFirstChildOfClass("Humanoid")
    baseSavedState.hadNoclip = state.noclipOn
    baseSavedState.hadFly    = state.flyOn
    baseSavedState.walkSpeed = h and h.WalkSpeed or 16
    baseSavedState.jumpPower = h and h.JumpPower or 50

    baseFlyState.flying   = true
    baseFlyState.noclipOn = true
    tpBaseBtn.Text = "GOING..."
    tpBaseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tpBaseBtn.BackgroundColor3 = Color3.fromRGB(35, 20, 60)

    -- FLY HEIGHT = 5 (very low, almost at ground level)
    local FLY_HEIGHT    = 5
    local SPEED         = 50000
    local STEP_CAP      = 5000
    local ARRIVE_RADIUS = 40
    local NEAR_RADIUS   = 500
    local DESCEND_RATE  = 0.10
    local TICK_DELAY    = 0.03
    local LAND_HEIGHT   = 3

    local stepPerTick = math.min(SPEED * TICK_DELAY, STEP_CAP)

    task.spawn(function()
        while baseFlyState.flying do
            local cc = player.Character
            if not cc then baseFullStop("Character gone"); return end
            local rr = cc:FindFirstChild("HumanoidRootPart")
            if not rr then baseFullStop("Root gone"); return end

            local bp = findMyBaseFly()
            if not bp then baseFullStop("Base lost"); return end
            basePos = bp

            local flatDiff = Vector3.new(
                basePos.X - rr.Position.X,
                0,
                basePos.Z - rr.Position.Z
            )
            local flatDist = flatDiff.Magnitude

            local targetY
            if flatDist > NEAR_RADIUS then
                targetY = basePos.Y + FLY_HEIGHT
            else
                local t = flatDist / NEAR_RADIUS
                local hh = LAND_HEIGHT + (FLY_HEIGHT - LAND_HEIGHT) * t
                targetY = basePos.Y + hh
            end

            local target = Vector3.new(basePos.X, targetY, basePos.Z)
            local diff = target - rr.Position
            local dist = diff.Magnitude

            if flatDist <= ARRIVE_RADIUS
                and math.abs(rr.Position.Y - (basePos.Y + LAND_HEIGHT)) <= 15 then
                local landing = Vector3.new(
                    basePos.X,
                    basePos.Y + LAND_HEIGHT,
                    basePos.Z
                )
                pcall(function()
                    cc:PivotTo(CFrame.new(landing))
                end)
                task.wait(0.1)
                baseFullStop("Arrived at base")
                return
            end

            local step
            if dist < stepPerTick then
                step = diff
            else
                step = diff.Unit * stepPerTick
            end

            if flatDist <= NEAR_RADIUS then
                local newY = rr.Position.Y
                    + (targetY - rr.Position.Y) * DESCEND_RATE
                step = Vector3.new(step.X, newY - rr.Position.Y, step.Z)
            end

            pcall(function()
                cc:PivotTo(CFrame.new(rr.Position + step))
            end)

            local cam = workspace.CurrentCamera
            if cam and cam.CameraType ~= Enum.CameraType.Custom then
                cam.CameraType = Enum.CameraType.Custom
            end

            task.wait(TICK_DELAY)
        end
    end)
end)

