local function eggColor(name)
    local n = name:lower()
    if n:match("celestial") then return Color3.fromRGB(255, 220, 120) end
    if n:match("cherub")    then return Color3.fromRGB(255, 150, 220) end
    if n:match("black")     then return Color3.fromRGB(180, 0, 255) end
    if n:match("galaxy")    then return Color3.fromRGB(140, 80, 255) end
    if n:match("aurora")    then return Color3.fromRGB(0, 255, 200) end
    if n:match("soul")      then return Color3.fromRGB(80, 200, 255) end
    if n:match("sinister")  then return Color3.fromRGB(255, 60, 60) end
    if n:match("flaming")   then return Color3.fromRGB(255, 120, 40) end
    if n:match("dominus")   then return Color3.fromRGB(220, 180, 60) end
    if n:match("skull")     then return Color3.fromRGB(220, 220, 220) end
    if n:match("cracked")   then return Color3.fromRGB(200, 200, 200) end
    if n:match("brown")     then return Color3.fromRGB(180, 120, 80) end
    return Color3.fromRGB(240, 240, 240)
end

local function createESP(part, label, color)
    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = part
    box.AlwaysOnTop = true
    box.Size = part.Size + Vector3.new(0.5, 0.5, 0.5)
    box.Transparency = 0.35
    box.Color3 = color
    box.Parent = espFolder

    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.Size = UDim2.new(0, 140, 0, 24)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = espFolder

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 1, 0)
    t.BackgroundTransparency = 1
    t.Text = label
    t.TextColor3 = color
    t.TextStrokeTransparency = 0
    t.TextStrokeColor3 = Color3.new(0,0,0)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 11
    t.Parent = bb
end

local function clearESP()
