local function playIntro()
    intro.Visible = true
    intro.BackgroundTransparency = 1
    square.Size = UDim2.new(0, 100, 0, 100)
    square.BackgroundTransparency = 1
    sqStroke.Transparency = 1
    introImage.ImageTransparency = 1
    introTitle.Position = UDim2.new(0.5, 0, 0.5, 180)
    introTitle.TextTransparency = 1

    task.spawn(function()
        local s = tick()
        while true do
            local p = math.clamp((tick() - s) / 1.0, 0, 1)
            local e = 1 - (1 - p) ^ 3
            local sz = 100 + 160 * e
            square.Size = UDim2.new(0, sz, 0, sz)
            square.BackgroundTransparency = 1 - e
            sqStroke.Transparency = 1 - e
            introImage.ImageTransparency = 1 - e
            if p >= 1 then break end
            task.wait(0.03)
        end
        local s2 = tick()
        while true do
            local p = math.clamp((tick() - s2) / 0.8, 0, 1)
            local e = 1 - (1 - p) ^ 3
            introTitle.Position = UDim2.new(0.5, 0, 0.5, 180 - 40 * e)
            introTitle.TextTransparency = 1 - e
            if p >= 1 then break end
            task.wait(0.03)
        end
        task.wait(2.0)
        local s3 = tick()
        while true do
            local p = math.clamp((tick() - s3) / 0.8, 0, 1)
            square.BackgroundTransparency = p
            sqStroke.Transparency = p
            introImage.ImageTransparency = p
            introTitle.TextTransparency = p
            intro.BackgroundTransparency = p
            if p >= 1 then break end
            task.wait(0.03)
        end
        intro.Visible = false
    end)
end

