local function makeTab(name, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = T.panel
    btn.BackgroundTransparency = 0.4
    btn.Text = name
    btn.TextColor3 = T.dim
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    btn.ZIndex = 7
    btn.Parent = sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local s = Instance.new("UIStroke")
    s.Color = T.panelHi
    s.Thickness = 1
    s.Transparency = 0.6
    s.Parent = btn

    local activeBar = Instance.new("Frame")
    activeBar.Size = UDim2.new(0, 3, 0, 0)
    activeBar.Position = UDim2.new(0, -1, 0.5, 0)
    activeBar.AnchorPoint = Vector2.new(0, 0.5)
    activeBar.BackgroundColor3 = T.accent2
    activeBar.BorderSizePixel = 0
    activeBar.BackgroundTransparency = 1
    activeBar.ZIndex = 8
    activeBar.Parent = btn
    Instance.new("UICorner", activeBar).CornerRadius = UDim.new(1, 0)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -16, 1, -16)
    page.Position = UDim2.new(0, 8, 0, 8)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = T.accent
    page.Visible = false
    page.ZIndex = 7
    page.Parent = contentFrame

    local pLayout = Instance.new("UIListLayout", page)
    pLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pLayout.Padding = UDim.new(0, 6)
    pLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, pLayout.AbsoluteContentSize.Y + 8)
    end)

    pages[name] = { btn = btn, page = page, stroke = s, activeBar = activeBar, layout = pLayout }

    btn.MouseButton1Click:Connect(function()
        for n, p in pairs(pages) do
            p.page.Visible = (n == name)
            if n == name then
                p.btn.BackgroundColor3 = T.accent
                p.btn.BackgroundTransparency = 0
                p.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                p.stroke.Color = T.accent2
                p.stroke.Thickness = 2
                p.stroke.Transparency = 0.2
                p.activeBar.BackgroundTransparency = 0
            else
                p.btn.BackgroundColor3 = T.panel
                p.btn.BackgroundTransparency = 0.4
                p.btn.TextColor3 = T.dim
                p.stroke.Color = T.panelHi
                p.stroke.Thickness = 1
                p.stroke.Transparency = 0.6
                p.activeBar.BackgroundTransparency = 1
            end
        end
    end)

    return page
end

