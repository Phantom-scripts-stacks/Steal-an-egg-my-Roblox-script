    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(200, 200, 210)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    btn.Parent = tabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 80)
    stroke.Parent = btn

    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, -20, 1, -102)
    page.Position = UDim2.new(0, 10, 0, 96)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = win

    pages[name] = { btn = btn, page = page, stroke = stroke }

    btn.MouseButton1Click:Connect(function()
        for n, p in pairs(pages) do
            p.page.Visible = (n == name)
            if n == name then
                p.btn.BackgroundColor3 = Color3.fromRGB(70, 60, 110)
                p.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                p.stroke.Color = Color3.fromRGB(150, 120, 255)
                p.stroke.Thickness = 2
            else
                p.btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
                p.btn.TextColor3 = Color3.fromRGB(200, 200, 210)
                p.stroke.Color = Color3.fromRGB(60, 60, 80)
                p.stroke.Thickness = 1
            end
        end
    end)

    return page
end

