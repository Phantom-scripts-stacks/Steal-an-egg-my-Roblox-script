local function eggColor(name)
    local n = name:lower()
    if n:match("celestial") then return Color3.fromRGB(255, 220, 120) end
    if n:match("cherub")    then return Color3.fromRGB(255, 150, 220) end
    if n:match("black")     then return Color3.fromRGB(180, 0, 255) end
    if n:match("galaxy")    then return Color3.fromRGB(140, 80, 255) end
    if n:match("aurora")    then return Color3.fromRGB(0, 255, 200) end
    if n:match("soul")      then return Color3.fromRGB(80, 200, 255) end
    if n:match("sinister")  then return Color3.fromRGB(255, 60, 60) end
    if n:match("flaming")   then return Color3.fromRGB(255, 120, 40) end
    if n:match("dominus")   then return Color3.fromRGB(220, 180, 60) end
    if n:match("skull")     then return Color3.fromRGB(220, 220, 220) end
    if n:match("cracked")   then return Color3.fromRGB(200, 200, 200) end
    if n:match("brown")     then return Color3.fromRGB(180, 120, 80) end
    return Color3.fromRGB(240, 240, 240)
end

local function createESP(part, label, color)
    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = part
    box.AlwaysOnTop = true
    box.Size = part.Size + Vector3.new(0.5, 0.5, 0.5)
    box.Transparency = CONFIG.ESPFillAlpha
    box.Color3 = color
    box.Parent = espFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 150, 0, 26)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = espFolder

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = label
    txt.TextColor3 = color
    txt.TextStrokeTransparency = 0
    txt.TextStrokeColor3 = Color3.new(0,0,0)
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 12
    txt.Parent = billboard
end

local function clearESP()
    for _, c in ipairs(espFolder:GetChildren()) do c:Destroy() end
end

local function refreshESP()
    clearESP()
    if not espOn then return end
    for _, egg in ipairs(workspace:GetDescendants()) do
        local ok = (egg:IsA("Model") or egg:IsA("BasePart")) and egg.Name:lower():match(CONFIG.EggMatch)
        if ok and not isEggTaken(egg) then
            local part = getEggPart(egg)
            if part then
                local d = (part.Position - rootPart.Position).Magnitude
                if d <= CONFIG.ESPRange then
                    createESP(part, string.format("%s [%dm]", egg.Name, math.floor(d)), eggColor(egg.Name))
                end
            end
        end
    end
end

espBtn.MouseButton1Click:Connect(function()
    espOn = not espOn
    espBtn.Text = "Egg ESP: " .. (espOn and "ON" or "OFF")
    refreshESP()
end)

