    pcall(function()
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = state.speedOn and state.speedValue or 16 end
    end)
end

local function applyJump()
    pcall(function()
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then
            h.UseJumpPower = true
            h.JumpPower = state.jumpOn and state.jumpValue or 50
        end
    end)
end

